{
  "name": "lets-connect",
  "version": "1.17.0",
  "private": true,
  "description": "Let's Connect - a PWA that gives couples curated questions to discuss, one card at a time.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "init-db": "node scripts/init-db.js",
    "migrate": "node scripts/migrate-all.js",
    "migrate-add-question-source": "node scripts/migrate-add-question-source.js",
    "migrate-add-password-resets": "node scripts/migrate-add-password-resets.js",
    "migrate-add-owner-role": "node scripts/migrate-add-owner-role.js",
    "migrate-add-audit-log": "node scripts/migrate-add-audit-log.js",
    "migrate-add-question-reports": "node scripts/migrate-add-question-reports.js",
    "migrate-corpus-model": "node scripts/migrate-corpus-model.js",
    "migrate-add-lenses": "node scripts/migrate-add-lenses.js",
    "migrate-add-authoring": "node scripts/migrate-add-authoring.js",
    "migrate-add-access-codes": "node scripts/migrate-add-access-codes.js",
    "migrate-split-domains": "node scripts/migrate-split-domains.js",
    "migrate-add-brand-assets": "node scripts/migrate-add-brand-assets.js",
    "migrate-seed-corpus": "node scripts/migrate-seed-corpus.js",
    "migrate-domain-palette": "node scripts/migrate-domain-palette.js",
    "migrate-add-question-feedback": "node scripts/migrate-add-question-feedback.js",
    "kill-stray": "pkill -f 'node[ ]server' || echo 'nothing to kill'",
    "build-corpus": "node scripts/build-corpus.js",
    "seed-corpus": "node scripts/seed-corpus.js",
    "rewrite-questions": "node scripts/rewrite-questions.js",
    "check-schema": "node scripts/check-schema.js",
    "make-icons": "node scripts/make-icons.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14",
    "xlsx": "^0.18.5"
  }
}
