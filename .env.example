# Let's Connect - environment template.
# Copy to .env locally. On the Plesk server, hand-create .env in the application
# root; it is gitignored and survives every git pull.

# ---- Database ----
# Local dev: 127.0.0.1   |   Production (NOIZ/Plesk): localhost
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lets_connect
DB_USER=root
DB_PASSWORD=

# ---- Web server ----
# Local dev only. NEVER set PORT in production - Passenger assigns the port
# itself and setting it breaks the app.
#
# 3200 is this app's port. 3000 is the AppFirm CRM's - do not point this there.
PORT=3200

# ---- Session security ----
# Signs the login cookie. Use a long random string; different per environment.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-locally

# ---- Secrets at rest ----
# Dedicated key for anything encrypted in the database. Set this EXPLICITLY in
# production at install time so SESSION_SECRET can be rotated independently.
SECRET_KEY=change-me-locally-too

# ---- Environment ----
# Leave UNSET locally (that is what keeps the login cookie non-secure so
# http://localhost works). Set to "production" on the server.
# NODE_ENV=production
